<%layout("layouts/boilerplate")%>

    <div class="row mt-3">
        <div class="col-8 offset-3">


            <h2>Listing Details</h2>
        </div>

        <div class="col-6 offset-3">
            <div class="card">
                <img class="card-img-top show-image" src="<%=listing.img%>" alt="listing image">
                <div class="card-body">
                    <p class="card-text">
                        <b>
                            <%=listing.title%>
                        </b>
                        <br>
                        <%=listing.description%> <br>
                            &#8377;<%=listing.price.toLocaleString("en-IN")%>
                                <br>
                                <%=listing.country%>
                                    <br>
                                    <%=listing.location%>
                                        <br>

                    </p>
                </div>
            </div>
            <div class="btns">
                <form method="get" action="/listing/<%=listing._id%>/edit">
                    <button class="btn btn-dark offset-3 edit-btn">Edit</button>
                </form>
                <br>
                <form method="POST" action="/listing/<%=listing._id%>?_method=DELETE">
                    <button class="btn btn-dark btns  offset-5 ">Delete</button>
                </form>
            </div>
        </div>



    </div>