<% let path="layouts/boilerplate" ; %>
    <%layout(path)%>
        <style>
            #filter-wrapper {

                display: flex;

                align-items: center;

                justify-content: space-between;

                gap: 1rem;

                margin-top: 1rem;

            }

            /* Scrollable icons */
            #filters {

                display: flex;

                gap: 1rem;

                overflow-x: auto;

                white-space: nowrap;

                flex: 1;

                scrollbar-width: none;

                padding-bottom: 5px;

            }

            #filters::-webkit-scrollbar {
                display: none;
            }

            .filter {

                flex: 0 0 auto;

                text-align: center;

                opacity: 0.7;

                min-width: 80px;

                cursor: pointer;

                transition: 0.2s;

            }

            .filter:hover {

                opacity: 1;

                transform: scale(1.05);

            }

            .filter i {

                font-size: 1.2rem;

            }

            .filter p {

                font-size: 0.8rem;

                margin-top: 0.3rem;

            }

            /* Fixed tax button */
            .tax-toggle {

                flex-shrink: 0;

                border: 1px solid #ccc;

                border-radius: 1rem;

                padding: 0.8rem 1rem;

                background: white;

            }
        </style>
        <!-- <h1>All listings</h1> -->
