<% let path="layouts/boilerplate" ; %>
    <%layout(path)%>


        <div class="row mt-3 mb-3">
            <div class="col-8 offset-2">

                <h1>Edit your listing</h1>

                <form method="post" novalidate class="needs-validation" enctype="multipart/form-data"
                    action="/listing/<%=listing._id%>?_method=PATCH">
                    <div class="mb-3">
                        <label class="form-label" for="title">Title</label>
                        <input required name="listing[title]" type="text" value="<%=listing.title%> "
                            class="form-control">
                        <div class="invalid-feedback">Please enter Title !</div>

                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="description">Description</label>
                        <textarea required name="listing[description]" cols="30" rows="3"
                            class="form-control"> <%=listing.description%> </textarea>
                        <div class="invalid-feedback">Please enter Short Description !</div>

                    </div>
                    <div class="mb-3 ori-img">
                        Original Listing Image <br>
                        <img src="<%=ori_url%>" alt="">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="image">Change Image </label>
                        <input name="listing[img]" type="file" class="form-control">

                    </div>

                    <div class="row">
                        <div class="mb-3 col-md-4">

                            <label class="form-label" for="price">Price</label>
                            <input required class="form-control" name="listing[price]" type="number"
                                value="<%=listing.price%>">
                            <div class="invalid-feedback">Please enter valid Price !</div>

                        </div>

                        <div class="mb-3 col-md-8">

                            <label class="form-label" for="country">Country</label>
                            <input required class="form-control" name="listing[country]" type="text"
                                value="<%=listing.country%>">
                            <div class="invalid-feedback">Please enter valid Country !</div>

                        </div>
                    </div>
                    <div class="mb-3">

                        <label class="form-label" for="location">Location</label>
                        <input required class="form-control" name="listing[location]" type="text"
                            value="<%=listing.location%>">
                        <div class="invalid-feedback">Please enter valid Location !</div>

                    </div>


                    <button class="btn btn-dark edit-btn">Update</button>

                </form>

            </div>
        </div>