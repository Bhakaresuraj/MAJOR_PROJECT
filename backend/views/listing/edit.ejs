<%layout("layouts/boilerplate")%>


    <div class="row mt-3 mb-3">
        <div class="col-8 offset-2">

            <h1>Edit your listing</h1>

            <form method="post" action="/listing/<%=listing._id%>?_method=PATCH">

                <div class="mb-3">
                    <label class="form-label" for="title">Title</label>
                    <input name="listing[title]" type="text" value="<%=listing.title%> " class="form-control">

                </div>
                <div class="mb-3">
                    <label class="form-label" for="description">Description</label>
                    <textarea name="listing[description]" cols="30" rows="3"
                        class="form-control"> <%=listing.description%> </textarea>
                </div>
                <div class="mb-3">

                    <label class="form-label" for="image">Image URL</label>
                    <input name="img" class="form-control" type="text" value="<%=listing.img%>">
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">

                        <label class="form-label" for="price">Price</label>
                        <input class="form-control" name="listing[price]" type="number" value="<%=listing.price%>">
                    </div>

                    <div class="mb-3 col-md-8">

                        <label class="form-label" for="country">Country</label>
                        <input class="form-control" name="listing[country]" type="text" value="<%=listing.country%>">
                    </div>
                </div>
                <div class="mb-3">

                    <label class="form-label" for="location">Location</label>
                    <input class="form-control" name="listing[location]" type="text" value="<%=listing.location%>">
                </div>


                <button class="btn btn-dark edit-btn">Update</button>

            </form>

        </div>
    </div>