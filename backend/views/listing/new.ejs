<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>

<body>
    <h1>Create new listing</h1>
    <form method="post" action="/listing">
        <h4>Enter Title :</h4>
        <input name="title" type="text" placeholder="Enter the title">
        <br>
        <h4>Enter description :</h4>
        <textarea name="description" placeholder="Enter the Description" cols="30" rows="5"></textarea><br>
        <h4>Enter Image URL/link :</h4><input name="img" type="text" placeholder="Enter the image URL/link :"><br>
        <h4>Enter Price :</h4><input name="price" type="number" placeholder="Enter the Price :"><br>
        <h4>Enter location :</h4><input name="location" type="text" placeholder="Enter the location :"><br>
        <h4>Enter country :</h4><input name="country" type="text" placeholder="Enter the Country :"><br>
        <br><br>
        <button>LIST</button>
    </form>
</body>

</html>