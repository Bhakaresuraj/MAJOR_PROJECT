<% let path="layouts/boilerplate" ; %>
    <%layout(path)%>

    <div class="row">

        <div class="col-8 offset-2">
            <br>
            <h1>Create new listing</h1>
            <form method="post" action="/listing" novalidate class="needs-validation">
                <div class="mb-3">
                    <label class="form-label" for="title">Title</label>
                    <input required name="listing[title]" type="text" placeholder="Enter the title"
                        class="form-control">
                    <div class="invalid-feedback">Please enter Title !</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="description">Description</label>
                    <textarea required class="form-control" name="listing[description]"
                        placeholder="Enter the Description" cols="30" rows="2"></textarea>
                    <div class="invalid-feedback">Please enter short description !</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="image">Image Link</label>
                    <input name="listing[img]" type="text" class="form-control"
                        placeholder="Enter the image URL/link :">
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label class="form-label" for="price">Price</label>
                        <!-- type="number" -->
                        <input required name="listing[price]" class="form-control" placeholder="Enter the Price :">
                        <div class="invalid-feedback">Please enter valid price !</div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label class="form-label" for="country">Country</label>
                        <input required name="listing[country]" class="form-control" type="text"
                            placeholder="Enter the Country :">
                        <div class="invalid-feedback">Please enter valid Country !</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="location">Location</label>
                    <input required name="listing[location]" type="text" class="form-control"
                        placeholder="Enter the location :">
                    <div class="invalid-feedback">Please enter valid Location !</div>
                </div>

                <button class="btn btn-dark add-btn">Add </button>
                <br><br>
            </form>
        </div>

    </div>