<% let path="layouts/boilerplate" ; %>
<%layout(path)%>

<p id="location" hidden><%= listing.location %></p>


<div class="show-page">

    <!-- Hero Image -->
    <div class="show-hero">
        <img class="show-image" src="<%=listing.img.url%>" alt="<%=listing.title%>">
    </div>

    <!-- Main Content -->
    <div class="show-container">

        <!-- Left Column -->
        <div class="show-left">

            <h1 class="show-title"><%=listing.title%></h1>

            <div class="show-meta">
                <span class="show-location">
                    <i class="fa-solid fa-location-dot"></i>
                    <%=listing.location%>, <%=listing.country%>
                </span>
                <span class="show-owner">
                    <i class="fa-solid fa-user-circle"></i>
                    Hosted by <b><%=listing.owner.username%></b>
                </span>
            </div>

            <hr class="show-divider">

            <p class="show-description"><%=listing.description%></p>

            <div class="show-price-tag">
                <span class="price-amount">&#8377;<%=listing.price.toLocaleString("en-IN")%></span>
                <span class="price-label">&nbsp;/ night</span>
            </div>

            <!-- Edit / Delete Buttons -->
            <%if(currUser && listing.owner._id.equals(currUser._id)){%>
            <div class="show-action-btns">
                <form method="get" action="/listing/<%=listing._id%>/edit">
                    <button class="btn show-edit-btn">
                        <i class="fa-solid fa-pen"></i> Edit
                    </button>
                </form>
                <form method="POST" action="/listing/<%=listing._id%>?_method=DELETE">
                    <button class="btn show-delete-btn">
                        <i class="fa-solid fa-trash"></i> Delete
                    </button>
                </form>
            </div>
            <%}%>

            <hr class="show-divider">

            <!-- Map -->
            <h4 class="show-section-title">
                <i class="fa-solid fa-map-pin"></i> Where you'll be
            </h4>
            <div id="map"></div>

            <hr class="show-divider">

            <!-- Review Form -->
            <%if(currUser){%>
            <h4 class="show-section-title">Leave a Review</h4>
            <form class="needs-validation review-form" novalidate
                action="/listing/<%=listing._id%>/reviews" method="POST">

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="rating">Your Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                            value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="comment">Your Comment</label>
                    <textarea required class="form-control review-textarea" rows="4"
                        name="review[comment]" id="comment"
                        placeholder="Share your experience..."></textarea>
                    <div class="invalid-feedback">Please add a comment!</div>
                </div>

                <button class="btn show-review-btn">
                    <i class="fa-solid fa-paper-plane"></i> Submit Review
                </button>
            </form>
            <%}%>

            <!-- All Reviews -->
            <% if (listing.reviews.length > 0){ %>
            <hr class="show-divider">
            <h4 class="show-section-title">
                <i class="fa-solid fa-star"></i>
                <%=listing.reviews.length%> Review<%= listing.reviews.length > 1 ? 's' : '' %>
            </h4>
            <div class="reviews-grid">
                <% for (let review of listing.reviews){ %>
                <div class="review-card">
                    <div class="review-card-header">
                        <div class="review-avatar">
                            <%= review.owner.username.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <p class="review-username">@<%=review.owner.username%></p>
                            <p class="starability-result" data-rating="<%=review.rating%>"></p>
                        </div>
                    </div>
                    <p class="review-comment"><%=review.comment%></p>
                    <%if(currUser && review.owner._id.equals(currUser._id)){%>
                    <form method="POST"
                        action="/listing/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                        <button class="btn btn-sm review-delete-btn">
                            <i class="fa-solid fa-trash-can"></i> Delete
                        </button>
                    </form>
                    <%}%>
                </div>
                <% } %>
            </div>
            <% } %>

        </div>
        <!-- /Left Column -->

    </div>
    <!-- /Main Content -->

</div>

<script src="/JS/geocoding.js"></script>
<script src="/JS/map.js"></script>