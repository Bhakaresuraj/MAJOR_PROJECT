<% let path="layouts/boilerplate" ; %>
    <% layout(path) %>
        <div class="listings-page">

            <section id="filter-wrapper" class="filters-bar">
                <div id="filters" class="filters-scroll">

                    <div class="filter active">
                        <div><i class="fa-solid fa-fire"></i></div>
                        <p>Trending</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-bed"></i></div>
                        <p>Rooms</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-mountain-city"></i></div>
                        <p>Iconic City</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-mountain"></i></div>
                        <p>Mountain</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-brands fa-fort-awesome"></i></div>
                        <p>Castles</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-person-swimming"></i></div>
                        <p>Pool</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-campground"></i></div>
                        <p>Camping</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-cow"></i></div>
                        <p>Farms</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-snowflake"></i></div>
                        <p>Arctic</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-igloo"></i></div>
                        <p>Dome</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-ferry"></i></div>
                        <p>Boat</p>
                    </div>
                </div>

                <div class="tax-toggle">
                    <div class="form-check form-switch tax-switch-wrap">
                        <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch">
                        <label class="form-check-label" for="taxSwitch">Display total after taxes</label>
                    </div>
                </div>
            </section>

            <section class="listings-section">
                <div class="row g-4">
                    <% for(let listing of allListings){ %>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <a href="/listing/<%= listing._id %>" class="listing-link">
                                <article class="card listing-card h-100">

                                    <div class="listing-img-wrapper">
                                        <img src="<%= listing.img.url %>" class="card-img-top listing-img"
                                            alt="<%= listing.title %>">
                                        <div class="card-img-overlay listing-overlay"></div>
                                    </div>

                                    <div class="card-body listing-card-body">
                                        <p class="listing-location">
                                            <%= listing.location || "Beautiful Stay" %>
                                        </p>

                                        <h5 class="listing-title">
                                            <%= listing.title %>
                                        </h5>

                                        <p class="listing-price">
                                            <span class="price-base" data-price="<%= listing.price %>">
                                                ₹<%= listing.price.toLocaleString("en-IN") %>
                                            </span>
                                            <span class="tax-info" style="display: none;">
                                                &nbsp; · Total with GST: ₹<%= Math.round(listing.price *
                                                    1.18).toLocaleString("en-IN") %>
                                            </span>
                                        </p>
                                    </div>

                                </article>
                            </a>
                        </div>
                        <% } %>
                </div>
            </section>

        </div>
        <script>
            
        </script>